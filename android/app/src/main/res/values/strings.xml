    <!-- the permissions at the first start -->
    <string name="perms_title">Getting everything ready</string>
    <string name="perms_text">Armonico asks for a few permissions once now, so every part works from the start:\n\n• Notifications: the bridge runs as a service with a notification.\n• Running in the background: the piano is heard when the screen is off.\n• Display over other apps: a shortcut on the piano can open an app or a link.\n• Do Not Disturb access: a shortcut can turn it on and off.\n\nEach one opens in turn. Come back to Armonico after each, and it goes on to the next.</string>
    <string name="perms_go">Continue</string>
    <string name="perms_later">Later</string>
    <string name="perms_xiaomi_ask">Turn on \"Display pop-up windows while running in the background\", then come back</string>

