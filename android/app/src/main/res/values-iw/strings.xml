    <!-- the permissions at the first start -->
    <string name="perms_title">מכינים הכל</string>
    <string name="perms_text">Armonico מבקש עכשיו כמה הרשאות, פעם אחת, כדי שכל החלקים יעבדו מההתחלה:\n\n• התראות: הגשר רץ כשירות עם התראה.\n• ריצה ברקע: הפסנתר נשמע גם כשהמסך כבוי.\n• תצוגה מעל אפליקציות אחרות: קיצור בפסנתר יכול לפתוח אפליקציה או קישור.\n• גישה ל\"נא לא להפריע\": קיצור יכול להפעיל ולכבות אותו.\n\nכל אחת נפתחת בתורה. אחרי כל אחת חוזרים ל-Armonico, והוא עובר לבאה.</string>
    <string name="perms_go">המשך</string>
    <string name="perms_later">אחר כך</string>
    <string name="perms_xiaomi_ask">להפעיל \"הצגת חלונות קופצים בזמן ריצה ברקע\" ולחזור</string>

