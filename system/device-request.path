# @APP_TITLE@: the root actions the Armonico Pi screen may ask for (shut down, restart, the clock,
# the time zone, the sound output, the broker). The screen runs without root rights; it only
# writes the request file, and this root unit, which it cannot change, does the one action named.
[Unit]
Description=@APP_TITLE@ Pi screen request

[Path]
PathExists=@VAR_DIR@/device-request
Unit=@APP@-device-request.service

[Install]
WantedBy=multi-user.target
