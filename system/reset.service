# @APP_TITLE@: the full reset of the piano connection (unstick, USB reset, restart of everything).
[Unit]
Description=@APP_TITLE@ full reset

[Service]
Type=oneshot
ExecStart=@OPT_DIR@/bridge/piano_reset.sh
TimeoutStartSec=3min

# Root, because it resets USB and restarts services. It stops and starts the bridge, so it
# must not be a child of it: the path unit starts it on its own.
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectHostname=yes
UMask=0022
